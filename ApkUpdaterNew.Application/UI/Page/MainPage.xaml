<?xml version="1.0" encoding="utf-8"?>
<Page id="mainPage"
      background="#801E1E1E"
      xmlns="urn:apkupdaternew:xaml"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Storyboards>
        <Storyboard trigger="Show">
            <ColorAnimation property="background"
                            from="#FF1E1E1E"
                            to="#801E1E1E"
                            duration="300"
                            easing="CubicOut"/>
        </Storyboard>
    </Page.Storyboards>
    <StackPanel width="320"
                verticalAlignment="Center"
                horizontalAlignment="Center"
                orientation="Vertical">
        <TextBlock id="packageVersionText"
                   margin="0 0 0 25"
                   horizontalAlignment="Center"
                   fontSize="42"
                   fontWeight="Bold"
                   foreground="#CCFFFFFF"
                   text="{Binding PackageVersion}"/>
        <TextBlock id="helloText"
                   margin="0 0 0 20"
                   horizontalAlignment="Center"
                   fontSize="32"
                   fontWeight="Bold"
                   foreground="#FFFFFF"
                   textWrapping="Wrap"
                   text="Полупрозрачное окно OpenGLES"/>
        <Button id="openSettingsButton"
                height="72"
                margin="0 0 0 20"
                contentAlignment="Center"
                fontSize="36"
                fontWeight="Bold"
                foreground="#FFFFFF"
                background="#3A6EA5"
                command="{Binding NavigateToSettingsCommand}"
                text="Open settings"/>
        <Button id="updateButton"
                height="72"
                margin="0 0 0 16"
                contentAlignment="Center"
                fontSize="36"
                fontWeight="Bold"
                foreground="#FFFFFF"
                background="#3A6EA5"
                command="{Binding RequestApplicationUpdateCommand}"
                text="Update"/>
        <Button id="sendLogsButton"
                height="72"
                margin="0 0 0 16"
                contentAlignment="Center"
                fontSize="36"
                fontWeight="Bold"
                foreground="#FFFFFF"
                background="#3A6EA5"
                command="{Binding SendLogsCommand}"
                text="Send logs"/>
        <TextBlock id="statusText"
                   fontSize="32"
                   foreground="#FFFFFF"
                   textWrapping="Wrap"
                   text="{Binding Status}"/>
    </StackPanel>
</Page>